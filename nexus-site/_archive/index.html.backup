<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEAM KJSSE ROBOCON | Future of Robotics</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/TextPlugin.min.js"></script>


    <style>
        /* ========== CSS VARIABLES ========== */
        :root {
            --primary-bg: #0a0a0f;
            --secondary-bg: #12121a;
            --accent-cyan: #00f5ff;
            --accent-purple: #7b2cbf;
            --accent-pink: #ff006e;
            --accent-blue: #0099ff;
            --text-primary: #e0e0e0;
            --text-secondary: #a0a0a0;
            --glass-bg: rgba(18, 18, 26, 0.8);
            --glass-border: rgba(0, 245, 255, 0.2);
            --gradient-1: linear-gradient(135deg, #00f5ff 0%, #7b2cbf 100%);
            --gradient-2: linear-gradient(135deg, #ff006e 0%, #00f5ff 100%);
            --shadow-glow: 0 0 20px rgba(0, 245, 255, 0.5);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ========== RESET & BASE STYLES ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: var(--primary-bg);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--primary-bg);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--gradient-1);
            border-radius: 4px;
        }

        /* ========== LOADING SCREEN ========== */
        .loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--primary-bg);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            flex-direction: column;
        }

        .loader-robot {
            font-size: 80px;
            color: var(--accent-cyan);
            animation: robotPulse 1.5s ease-in-out infinite;
            text-shadow: 0 0 30px var(--accent-cyan), 0 0 60px var(--accent-cyan);
        }

        .loader-text {
            font-family: 'Orbitron', sans-serif;
            font-size: 24px;
            margin-top: 30px;
            color: var(--accent-cyan);
            letter-spacing: 8px;
        }

        .loader-bar {
            width: 200px;
            height: 4px;
            background: var(--secondary-bg);
            border-radius: 2px;
            margin-top: 20px;
            overflow: hidden;
        }

        .loader-progress {
            height: 100%;
            background: var(--gradient-1);
            width: 0%;
            animation: loadingProgress 2s ease-out forwards;
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        @keyframes robotPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        @keyframes loadingProgress {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        /* ========== CIRCUIT BOARD BACKGROUND ========== */
        .circuit-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.1;
        }

        .circuit-line {
            position: absolute;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        .circuit-dot {
            position: absolute;
            width: 8px;
            height: 8px;
            background: var(--accent-cyan);
            border-radius: 50%;
            box-shadow: 0 0 15px var(--accent-cyan);
        }

        /* ========== NAVIGATION ========== */
        .navbar {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1200px;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            transition: var(--transition);
        }

        .navbar.scrolled {
            top: 10px;
            background: rgba(10, 10, 15, 0.95);
            box-shadow: var(--shadow-glow);
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 24px;
            font-weight: 700;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            cursor: pointer;
            position: relative;
        }

        .logo::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--gradient-1);
            transform: scaleX(0);
            transition: var(--transition);
        }

        .logo:hover::after {
            transform: scaleX(1);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-primary);
            text-decoration: none;
            font-family: 'Rajdhani', sans-serif;
            font-size: 16px;
            font-weight: 500;
            position: relative;
            padding: 5px 0;
            transition: var(--transition);
        }

        .nav-links a::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 0;
            height: 2px;
            background: var(--gradient-1);
            transition: var(--transition);
            transform: translateX(-50%);
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--accent-cyan);
        }

        .nav-links a:hover::before,
        .nav-links a.active::before {
            width: 100%;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            z-index: 1001;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background: var(--accent-cyan);
            border-radius: 2px;
            transition: var(--transition);
        }

        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }

        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }

        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -7px);
        }

        /* ========== HERO SECTION ========== */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            text-align: center;
            padding: 0 20px;
        }

        .hero-particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--accent-cyan);
            border-radius: 50%;
            opacity: 0.6;
            animation: float 15s infinite;
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(100vh) translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 0.6;
            }
            90% {
                opacity: 0.6;
            }
            100% {
                transform: translateY(-100vh) translateX(100px);
                opacity: 0;
            }
        }

        .hero-content {
            z-index: 10;
        }

        .hero-logo {
            font-size: 120px;
            margin-bottom: 20px;
            animation: logoGlow 2s ease-in-out infinite;
            filter: drop-shadow(0 0 30px var(--accent-cyan));
        }

        @keyframes logoGlow {
            0%, 100% { filter: drop-shadow(0 0 30px var(--accent-cyan)); }
            50% { filter: drop-shadow(0 0 60px var(--accent-cyan)) drop-shadow(0 0 80px var(--accent-purple)); }
        }

        .hero-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 64px;
            font-weight: 900;
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
        }

        /* ========== HERO TITLE - CLEAN & ELEGANT ========== */
        .hero-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(42px, 8vw, 72px);
            font-weight: 700;
            margin-bottom: 30px;
            position: relative;
            display: inline-block;
            overflow: hidden;
        }

        .premium-title {
            position: relative;
            display: block;
            color: var(--accent-cyan);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Subtle animated gradient on hover - removed */

        @keyframes shimmer {
            0% { background-position: -100% 0; }
            100% { background-position: 200% 0; }
        }

        /* Elegant underline animation */
        .title-underline {
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(
                90deg,
                transparent 0%,
                var(--accent-cyan) 20%,
                var(--accent-blue) 50%,
                var(--accent-cyan) 80%,
                transparent 100%
            );
            transform: scaleX(0);
            transform-origin: center;
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .hero-title:hover .title-underline {
            transform: scaleX(1);
        }

        /* Subtle glow on hover */
        .title-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 120%;
            height: 200%;
            background: radial-gradient(
                ellipse at center,
                rgba(0, 245, 255, 0.08) 0%,
                transparent 50%
            );
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            filter: blur(40px);
        }

        .hero-title:hover .title-glow {
            opacity: 0;
        }

        /* Character reveal animation */
        .title-char {
            display: inline-block;
            opacity: 1;
            transform: translateY(0);
            transition: all 0.3s ease;
        }

        /* Hover effect per character */
        /* Hover effect per character */
        .title-char:hover {
            color: #ffffff;
            text-shadow:
                0 0 10px var(--accent-cyan),
                0 0 20px var(--accent-cyan),
                0 0 40px var(--accent-cyan),
                0 0 80px var(--accent-cyan);
            transform: scale(1.1);
        }
            z-index: -2;
            animation: glowPulse 3s ease-in-out infinite;
        }

        @keyframes glowPulse {
            0%, 100% {
                opacity: 0.5;
                transform: translate(-50%, -50%) scale(1);
            }
            50% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.1);
            }
        }

        .hero-tagline {
            font-family: 'Rajdhani', sans-serif;
            font-size: 28px;
            color: var(--text-secondary);
            margin-bottom: 40px;
            min-height: 40px;
        }

        .typewriter {
            display: inline;
            border-right: 2px solid var(--accent-cyan);
            padding-right: 5px;
            animation: blink 0.75s step-end infinite;
        }

        @keyframes blink {
            from, to { border-color: transparent; }
            50% { border-color: var(--accent-cyan); }
        }

        .hero-cta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .btn {
            padding: 15px 40px;
            border: none;
            border-radius: 50px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background: var(--gradient-1);
            color: white;
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 40px rgba(0, 245, 255, 0.5);
        }

        .btn-secondary {
            background: transparent;
            color: var(--accent-cyan);
            border: 2px solid var(--accent-cyan);
        }

        .btn-secondary:hover {
            background: rgba(0, 245, 255, 0.1);
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: scrollBounce 2s infinite;
        }

        .scroll-indicator i {
            font-size: 30px;
            color: var(--accent-cyan);
        }

        @keyframes scrollBounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-20px); }
            60% { transform: translateX(-50%) translateY(-10px); }
        }

        /* ========== SECTION STYLES ========== */
        section {
            padding: 100px 20px;
            position: relative;
            z-index: 1;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
        }

        .section-title::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background: var(--gradient-1);
            border-radius: 2px;
        }

        .section-subtitle {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px;
            color: var(--text-secondary);
        }

        /* ========== ABOUT SECTION ========== */
        .about {
            background: linear-gradient(180deg, var(--primary-bg) 0%, var(--secondary-bg) 100%);
        }

        .about-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .timeline {
            position: relative;
            padding: 20px 0;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 100%;
            background: var(--gradient-1);
            box-shadow: 0 0 10px var(--accent-cyan);
        }

        .timeline-item {
            display: flex;
            justify-content: flex-end;
            padding-right: 30px;
            position: relative;
            margin-bottom: 50px;
            width: 50%;
        }

        .timeline-item:nth-child(even) {
            align-self: flex-end;
            justify-content: flex-start;
            padding-right: 0;
            padding-left: 30px;
            margin-left: 50%;
        }

        .timeline-dot {
            position: absolute;
            right: -8px;
            top: 20px;
            width: 16px;
            height: 16px;
            background: var(--accent-cyan);
            border-radius: 50%;
            box-shadow: 0 0 20px var(--accent-cyan);
            z-index: 10;
        }

        .timeline-item:nth-child(even) .timeline-dot {
            right: auto;
            left: -8px;
        }

        .timeline-content {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            padding: 30px;
            backdrop-filter: blur(10px);
            transition: var(--transition);
        }

        .timeline-content:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-glow);
        }

        .timeline-year {
            font-family: 'Orbitron', sans-serif;
            font-size: 24px;
            color: var(--accent-cyan);
            margin-bottom: 10px;
        }

        .timeline-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .timeline-desc {
            color: var(--text-secondary);
        }

        /* ========== ACHIEVEMENTS CARDS ========== */
        .achievements {
            margin-top: 80px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .achievement-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }

        .achievement-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient-1);
            opacity: 0;
            transition: var(--transition);
        }

        .achievement-card:hover::before {
            opacity: 0.1;
        }

        .achievement-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-glow);
        }

        .achievement-icon {
            font-size: 50px;
            margin-bottom: 20px;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .achievement-number {
            font-family: 'Orbitron', sans-serif;
            font-size: 48px;
            font-weight: 700;
            color: var(--accent-cyan);
            margin-bottom: 10px;
        }

        .achievement-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px;
            font-weight: 600;
        }

        /* ========== ROBOTS SHOWCASE ========== */
        .robots {
            background: var(--primary-bg);
        }

        .robots-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }

        .robot-card {
            perspective: 1000px;
            height: 500px;
        }

        .robot-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.8s;
            transform-style: preserve-3d;
        }

        .robot-card:hover .robot-card-inner {
            transform: rotateY(180deg);
        }

        .robot-card-front,
        .robot-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            overflow: hidden;
        }

        .robot-card-front {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
        }

        .robot-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            position: relative;
        }

        .robot-image-placeholder {
            width: 100%;
            height: 300px;
            background: var(--gradient-1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 80px;
            color: rgba(255, 255, 255, 0.3);
        }

        .robot-info {
            padding: 20px;
        }

        .robot-name {
            font-family: 'Orbitron', sans-serif;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--accent-cyan);
        }

        .robot-year {
            font-family: 'Rajdhani', sans-serif;
            font-size: 16px;
            color: var(--text-secondary);
        }

        .robot-card-back {
            background: var(--secondary-bg);
            border: 1px solid var(--glass-border);
            transform: rotateY(180deg);
            padding: 30px;
            overflow-y: auto;
        }

        .spec-item {
            margin-bottom: 20px;
            text-align: left;
        }

        .spec-label {
            font-family: 'Rajdhani', sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 5px;
        }

        .spec-bar {
            width: 100%;
            height: 8px;
            background: var(--primary-bg);
            border-radius: 4px;
            overflow: hidden;
        }

        .spec-fill {
            height: 100%;
            background: var(--gradient-1);
            border-radius: 4px;
            width: 0;
            transition: width 1s ease-out;
        }

        .robot-description {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-top: 20px;
        }

        /* ========== DEPARTMENTS SECTION ========== */
        .departments {
            background: linear-gradient(180deg, var(--secondary-bg) 0%, var(--primary-bg) 100%);
        }

        .departments-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 40px;
        }

        .dept-card {
            position: relative;
            padding: 40px 30px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);
            transition: var(--transition);
            text-align: center;
        }

        .dept-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient-1);
            opacity: 0;
            transition: var(--transition);
            z-index: -1;
        }

        .dept-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.4);
        }

        .dept-card:hover::before {
            opacity: 0.1;
        }

        .dept-icon {
            font-size: 60px;
            margin-bottom: 20px;
            display: inline-block;
            transition: var(--transition);
        }

        .dept-card:hover .dept-icon {
            transform: scale(1.2) rotate(360deg);
        }

        .dept-name {
            font-family: 'Orbitron', sans-serif;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 15px;
            color: var(--accent-cyan);
        }

        .dept-desc {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.6;
        }

        /* Department colors */
        .dept-card.mechanical .dept-icon { color: var(--accent-cyan); }
        .dept-card.electronics .dept-icon { color: var(--accent-purple); }
        .dept-card.programming .dept-icon { color: var(--accent-pink); }
        .dept-card.management .dept-icon { color: var(--accent-blue); }

        /* ========== STATS SECTION ========== */
        .stats {
            background: var(--secondary-bg);
            position: relative;
            overflow: hidden;
        }

        .stats-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
        }

        .stat-item {
            text-align: center;
            padding: 40px 20px;
            position: relative;
        }

        .stat-circle {
            width: 150px;
            height: 150px;
            margin: 0 auto 20px;
            position: relative;
        }

        .stat-circle svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }

        .stat-circle-bg {
            fill: none;
            stroke: var(--primary-bg);
            stroke-width: 8;
        }

        .stat-circle-progress {
            fill: none;
            stroke: url(#gradient);
            stroke-width: 8;
            stroke-linecap: round;
            stroke-dasharray: 440;
            stroke-dashoffset: 440;
            transition: stroke-dashoffset 2s ease-out;
        }

        .stat-number {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: 'Orbitron', sans-serif;
            font-size: 36px;
            font-weight: 700;
            color: var(--accent-cyan);
        }

        .stat-label {
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            color: var(--text-secondary);
        }

        .float-animation {
            animation: floatStat 3s ease-in-out infinite;
        }

        @keyframes floatStat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        /* ========== SPONSORS SECTION ========== */
        .sponsors {
            background: var(--primary-bg);
            overflow: hidden;
        }

        .sponsors-marquee {
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
        }

        .marquee-track {
            display: inline-block;
            animation: marquee 30s linear infinite;
        }

        .sponsor-logo {
            display: inline-block;
            margin: 0 40px;
            width: 150px;
            height: 80px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            color: var(--text-secondary);
            transition: var(--transition);
            cursor: pointer;
        }

        .sponsor-logo:hover {
            transform: scale(1.1);
            box-shadow: var(--shadow-glow);
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
        }

        @keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .sponsors-marquee:hover .marquee-track {
            animation-play-state: paused;
        }

        /* ========== CONTACT SECTION ========== */
        .contact {
            background: linear-gradient(180deg, var(--primary-bg) 0%, var(--secondary-bg) 100%);
        }

        .contact-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            transition: var(--transition);
        }

        .contact-item:hover {
            transform: translateX(10px);
            box-shadow: var(--shadow-glow);
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background: var(--gradient-1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
        }

        .contact-details h4 {
            font-family: 'Orbitron', sans-serif;
            font-size: 16px;
            margin-bottom: 5px;
            color: var(--accent-cyan);
        }

        .contact-details p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .social-link {
            width: 50px;
            height: 50px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--text-primary);
            text-decoration: none;
            transition: var(--transition);
        }

        .social-link:hover {
            background: var(--gradient-1);
            transform: translateY(-5px);
            box-shadow: var(--shadow-glow);
            color: white;
        }

        .contact-form {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 40px;
            backdrop-filter: blur(10px);
        }

        .form-group {
            position: relative;
            margin-bottom: 30px;
        }

        .form-input {
            width: 100%;
            padding: 15px 20px;
            background: var(--primary-bg);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            color: var(--text-primary);
            font-size: 16px;
            font-family: 'Roboto', sans-serif;
            transition: var(--transition);
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent-cyan);
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.2);
        }

        .form-label {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 16px;
            pointer-events: none;
            transition: var(--transition);
            background: var(--primary-bg);
            padding: 0 5px;
        }

        .form-input:focus ~ .form-label,
        .form-input:not(:placeholder-shown) ~ .form-label {
            top: 0;
            font-size: 12px;
            color: var(--accent-cyan);
        }

        textarea.form-input {
            resize: vertical;
            min-height: 120px;
        }

        .submit-btn {
            width: 100%;
            padding: 15px;
            background: var(--gradient-1);
            border: none;
            border-radius: 10px;
            color: white;
            font-family: 'Orbitron', sans-serif;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .submit-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: 0.5s;
        }

        .submit-btn:hover::before {
            left: 100%;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.5);
        }

        /* ========== FOOTER ========== */
        footer {
            background: var(--secondary-bg);
            border-top: 1px solid var(--glass-border);
            padding: 60px 20px 20px;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-family: 'Orbitron', sans-serif;
            font-size: 20px;
            margin-bottom: 20px;
            color: var(--accent-cyan);
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-family: 'Rajdhani', sans-serif;
            font-size: 16px;
            transition: var(--transition);
            display: inline-block;
        }

        .footer-links a:hover {
            color: var(--accent-cyan);
            transform: translateX(5px);
        }

        .footer-bottom {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid var(--glass-border);
            color: var(--text-secondary);
            font-size: 14px;
        }

        .footer-bottom span {
            color: var(--accent-cyan);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* ========== RESPONSIVE DESIGN ========== */
        @media (max-width: 968px) {
            .hero-title {
                font-size: 42px;
            }

            .hero-logo {
                font-size: 80px;
            }

            .nav-links {
                position: fixed;
                top: 0;
                right: -100%;
                width: 70%;
                height: 100vh;
                background: var(--glass-bg);
                backdrop-filter: blur(20px);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                transition: 0.5s;
                border-left: 1px solid var(--glass-border);
            }

            .nav-links.active {
                right: 0;
            }

            .hamburger {
                display: flex;
            }

            .timeline::before {
                left: 20px;
            }

            .timeline-item {
                width: 100%;
                padding-left: 50px;
                padding-right: 0;
            }

            .timeline-item:nth-child(even) {
                margin-left: 0;
            }

            .timeline-dot {
                left: 12px;
                right: auto;
            }

            .contact-container {
                grid-template-columns: 1fr;
            }

            .robots-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .hero-title {
                font-size: 32px;
            }

            .hero-tagline {
                font-size: 18px;
            }

            .section-title {
                font-size: 32px;
            }

            .hero-cta {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }

        /* ========== UTILITY CLASSES ========== */
        .gradient-text {
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glow {
            box-shadow: var(--shadow-glow);
        }

        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
        }
    </style>
</head>
<body>
    <!-- Loading Screen -->
    <div class="loader">
        <div class="loader-robot">
            <i class="fas fa-robot"></i>
        </div>
        <div class="loader-text">INITIALIZING</div>
        <div class="loader-bar">
            <div class="loader-progress"></div>
        </div>
    </div>

    <!-- Circuit Board Background -->
    <div class="circuit-bg" id="circuitBg"></div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="logo">KJSSE ROBOCON</div>
        <ul class="nav-links">
            <li><a href="#home" class="active">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#robots">Robots</a></li>
            <li><a href="#departments">Departments</a></li>
            <li><a href="#sponsors">Sponsors</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-particles" id="particles"></div>
        <div class="hero-content">
            <div class="hero-logo">
                <i class="fas fa-microchip"></i>
            </div>
            <div class="title-glow"></div>
            <h1 class="hero-title">
                <span class="premium-title" id="premiumTitle">TEAM KJSSE ROBOCON</span>
                <div class="title-underline"></div>
            </h1>
            <p class="hero-tagline">
                <span class="typewriter" id="typewriter"></span>
            </p>
            <div class="hero-cta">
                <a href="#robots" class="btn btn-primary">Explore Robots</a>
                <a href="#contact" class="btn btn-secondary">Join Us</a>
            </div>
        </div>
        <div class="scroll-indicator">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
        <div class="section-header">
            <h2 class="section-title">About Us</h2>
            <p class="section-subtitle">Pioneering Innovation Since 2015</p>
        </div>

        <div class="about-content">
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year">2015</div>
                        <h3 class="timeline-title">Team Foundation</h3>
                        <p class="timeline-desc">KJSSE Robocon was established with a vision to excel in robotics competitions and foster innovation among students.</p>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year">2018</div>
                        <h3 class="timeline-title">First National Victory</h3>
                        <p class="timeline-desc">Secured first position at Robocon National Competition, marking our dominance in Indian robotics.</p>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year">2021</div>
                        <h3 class="timeline-title">International Debut</h3>
                        <p class="timeline-desc">Represented India at the International Robocon Competition, showcasing our innovative solutions globally.</p>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year">2024</div>
                        <h3 class="timeline-title">Legacy Continues</h3>
                        <p class="timeline-desc">Continuing our tradition of excellence with cutting-edge robotics and AI integration.</p>
                    </div>
                </div>
            </div>

            <div class="achievements">
                <div class="achievement-card">
                    <div class="achievement-icon">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="achievement-number" data-target="15">0</div>
                    <div class="achievement-title">National Awards</div>
                </div>

                <div class="achievement-card">
                    <div class="achievement-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="achievement-number" data-target="25">0</div>
                    <div class="achievement-title">Robots Built</div>
                </div>

                <div class="achievement-card">
                    <div class="achievement-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="achievement-number" data-target="150">0</div>
                    <div class="achievement-title">Team Members</div>
                </div>

                <div class="achievement-card">
                    <div class="achievement-icon">
                        <i class="fas fa-globe"></i>
                    </div>
                    <div class="achievement-number" data-target="5">0</div>
                    <div class="achievement-title">International Events</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Robots Showcase Section -->
    <section class="robots" id="robots">
        <div class="section-header">
            <h2 class="section-title">Our Robots</h2>
            <p class="section-subtitle">Engineering Marvels That Define Excellence</p>
        </div>

        <div class="robots-grid">
            <div class="robot-card">
                <div class="robot-card-inner">
                    <div class="robot-card-front">
                        <div class="robot-image-placeholder">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="robot-info">
                            <h3 class="robot-name">PHOENIX X1</h3>
                            <p class="robot-year">2024 Edition</p>
                        </div>
                    </div>
                    <div class="robot-card-back">
                        <h3 style="color: var(--accent-cyan); margin-bottom: 20px; font-family: 'Orbitron', sans-serif;">Specifications</h3>

                        <div class="spec-item">
                            <div class="spec-label">Speed</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="90%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Precision</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="85%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Autonomy</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="95%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Power Efficiency</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="80%"></div>
                            </div>
                        </div>

                        <p class="robot-description">
                            Phoenix X1 is our flagship robot featuring advanced AI navigation,
                            precision gripping mechanisms, and real-time obstacle detection.
                            Built for the 2024 Robocon challenge.
                        </p>
                    </div>
                </div>
            </div>

            <div class="robot-card">
                <div class="robot-card-inner">
                    <div class="robot-card-front">
                        <div class="robot-image-placeholder">
                            <i class="fas fa-cogs"></i>
                        </div>
                        <div class="robot-info">
                            <h3 class="robot-name">TITAN V2</h3>
                            <p class="robot-year">2023 Edition</p>
                        </div>
                    </div>
                    <div class="robot-card-back">
                        <h3 style="color: var(--accent-cyan); margin-bottom: 20px; font-family: 'Orbitron', sans-serif;">Specifications</h3>

                        <div class="spec-item">
                            <div class="spec-label">Speed</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="75%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Precision</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="90%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Autonomy</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="70%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Power Efficiency</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="85%"></div>
                            </div>
                        </div>

                        <p class="robot-description">
                            Titan V2 excels in heavy-duty tasks with its powerful motors and
                            robust construction. Features advanced image processing for
                            object recognition and manipulation.
                        </p>
                    </div>
                </div>
            </div>

            <div class="robot-card">
                <div class="robot-card-inner">
                    <div class="robot-card-front">
                        <div class="robot-image-placeholder">
                            <i class="fas fa-microchip"></i>
                        </div>
                        <div class="robot-info">
                            <h3 class="robot-name">NEBULA PRO</h3>
                            <p class="robot-year">2022 Edition</p>
                        </div>
                    </div>
                    <div class="robot-card-back">
                        <h3 style="color: var(--accent-cyan); margin-bottom: 20px; font-family: 'Orbitron', sans-serif;">Specifications</h3>

                        <div class="spec-item">
                            <div class="spec-label">Speed</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="95%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Precision</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="80%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Autonomy</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="88%"></div>
                            </div>
                        </div>

                        <div class="spec-item">
                            <div class="spec-label">Power Efficiency</div>
                            <div class="spec-bar">
                                <div class="spec-fill" data-width="75%"></div>
                            </div>
                        </div>

                        <p class="robot-description">
                            Nebula Pro is designed for speed and agility. Features cutting-edge
                            sensor fusion technology and machine learning algorithms for
                            adaptive behavior.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Departments Section -->
    <section class="departments" id="departments">
        <div class="section-header">
            <h2 class="section-title">Departments</h2>
            <p class="section-subtitle">Specialized Teams Driving Innovation</p>
        </div>

        <div class="departments-grid">
            <div class="dept-card mechanical">
                <div class="dept-icon">
                    <i class="fas fa-wrench"></i>
                </div>
                <h3 class="dept-name">Mechanical</h3>
                <p class="dept-desc">
                    Design and fabricate robust robot structures using CAD/CAM,
                    3D printing, and precision machining. Responsible for
                    all mechanical systems and mechanisms.
                </p>
            </div>

            <div class="dept-card electronics">
                <div class="dept-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3 class="dept-name">Electronics</h3>
                <p class="dept-desc">
                    Develop custom PCBs, power management systems, and sensor
                    arrays. Handle all electronic circuitry and embedded
                    systems integration.
                </p>
            </div>

            <div class="dept-card programming">
                <div class="dept-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h3 class="dept-name">Programming</h3>
                <p class="dept-desc">
                    Create autonomous navigation algorithms, computer vision
                    systems, and AI-powered decision-making. Code the brain
                    behind every robot.
                </p>
            </div>

            <div class="dept-card management">
                <div class="dept-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="dept-name">Management</h3>
                <p class="dept-desc">
                    Handle sponsorships, public relations, logistics, and
                    team coordination. Ensure smooth operations and
                    represent the team professionally.
                </p>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats" id="stats">
        <svg style="position: absolute; width: 0; height: 0;">
            <defs>
                <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" style="stop-color: #00f5ff;"/>
                    <stop offset="100%" style="stop-color: #7b2cbf;"/>
                </linearGradient>
            </defs>
        </svg>

        <div class="section-header">
            <h2 class="section-title">Our Impact</h2>
            <p class="section-subtitle">Numbers That Speak</p>
        </div>

        <div class="stats-grid">
            <div class="stat-item float-animation">
                <div class="stat-circle">
                    <svg>
                        <circle class="stat-circle-bg" cx="75" cy="75" r="70"></circle>
                        <circle class="stat-circle-progress" cx="75" cy="75" r="70" data-progress="95"></circle>
                    </svg>
                    <div class="stat-number">95%</div>
                </div>
                <p class="stat-label">Success Rate</p>
            </div>

            <div class="stat-item float-animation" style="animation-delay: 0.2s;">
                <div class="stat-circle">
                    <svg>
                        <circle class="stat-circle-bg" cx="75" cy="75" r="70"></circle>
                        <circle class="stat-circle-progress" cx="75" cy="75" r="70" data-progress="85"></circle>
                    </svg>
                    <div class="stat-number">85%</div>
                </div>
                <p class="stat-label">On-Time Delivery</p>
            </div>

            <div class="stat-item float-animation" style="animation-delay: 0.4s;">
                <div class="stat-circle">
                    <svg>
                        <circle class="stat-circle-bg" cx="75" cy="75" r="70"></circle>
                        <circle class="stat-circle-progress" cx="75" cy="75" r="70" data-progress="90"></circle>
                    </svg>
                    <div class="stat-number">90%</div>
                </div>
                <p class="stat-label">Innovation Score</p>
            </div>

            <div class="stat-item float-animation" style="animation-delay: 0.6s;">
                <div class="stat-circle">
                    <svg>
                        <circle class="stat-circle-bg" cx="75" cy="75" r="70"></circle>
                        <circle class="stat-circle-progress" cx="75" cy="75" r="70" data-progress="100"></circle>
                    </svg>
                    <div class="stat-number">100%</div>
                </div>
                <p class="stat-label">Team Dedication</p>
            </div>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section class="sponsors" id="sponsors">
        <div class="section-header">
            <h2 class="section-title">Our Sponsors</h2>
            <p class="section-subtitle">Partners in Innovation</p>
        </div>

        <div class="sponsors-marquee">
            <div class="marquee-track">
                <div class="sponsor-logo">SPONSOR 1</div>
                <div class="sponsor-logo">SPONSOR 2</div>
                <div class="sponsor-logo">SPONSOR 3</div>
                <div class="sponsor-logo">SPONSOR 4</div>
                <div class="sponsor-logo">SPONSOR 5</div>
                <div class="sponsor-logo">SPONSOR 6</div>
                <div class="sponsor-logo">SPONSOR 7</div>
                <div class="sponsor-logo">SPONSOR 8</div>
                <div class="sponsor-logo">SPONSOR 1</div>
                <div class="sponsor-logo">SPONSOR 2</div>
                <div class="sponsor-logo">SPONSOR 3</div>
                <div class="sponsor-logo">SPONSOR 4</div>
                <div class="sponsor-logo">SPONSOR 5</div>
                <div class="sponsor-logo">SPONSOR 6</div>
                <div class="sponsor-logo">SPONSOR 7</div>
                <div class="sponsor-logo">SPONSOR 8</div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <div class="section-header">
            <h2 class="section-title">Get In Touch</h2>
            <p class="section-subtitle">Let's Build Something Amazing Together</p>
        </div>

        <div class="contact-container">
            <div class="contact-info">
                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="contact-details">
                        <h4>Location</h4>
                        <p>KJSSE, Somaiya Campus, Vidyanagar, Mumbai - 400077</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="contact-details">
                        <h4>Email</h4>
                        <p>robocon@somaiya.edu</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div class="contact-details">
                        <h4>Phone</h4>
                        <p>+91 98765 43210</p>
                    </div>
                </div>

                <div class="social-links">
                    <a href="#" class="social-link">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" class="social-link">
                        <i class="fab fa-linkedin"></i>
                    </a>
                    <a href="#" class="social-link">
                        <i class="fab fa-youtube"></i>
                    </a>
                    <a href="#" class="social-link">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="social-link">
                        <i class="fab fa-github"></i>
                    </a>
                </div>
            </div>

            <form class="contact-form" id="contactForm">
                <div class="form-group">
                    <input type="text" class="form-input" id="name" placeholder=" " required>
                    <label class="form-label" for="name">Your Name</label>
                </div>

                <div class="form-group">
                    <input type="email" class="form-input" id="email" placeholder=" " required>
                    <label class="form-label" for="email">Email Address</label>
                </div>

                <div class="form-group">
                    <input type="text" class="form-input" id="subject" placeholder=" " required>
                    <label class="form-label" for="subject">Subject</label>
                </div>

                <div class="form-group">
                    <textarea class="form-input" id="message" placeholder=" " required></textarea>
                    <label class="form-label" for="message">Your Message</label>
                </div>

                <button type="submit" class="submit-btn">
                    Send Message <i class="fas fa-paper-plane" style="margin-left: 10px;"></i>
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>About Us</h3>
                <p style="color: var(--text-secondary); line-height: 1.6;">
                    Team KJSSE Robocon is a passionate group of students dedicated to
                    pushing the boundaries of robotics and automation. We compete at
                    national and international levels, showcasing innovation and excellence.
                </p>
            </div>

            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul class="footer-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#robots">Robots</a></li>
                    <li><a href="#departments">Departments</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h3>Legal</h3>
                <ul class="footer-links">
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                    <li><a href="#">Cookie Policy</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h3>Newsletter</h3>
                <p style="color: var(--text-secondary); margin-bottom: 15px;">
                    Subscribe for updates on our latest projects and achievements.
                </p>
                <div style="display: flex; gap: 10px;">
                    <input type="email" placeholder="Your email" style="
                        flex: 1;
                        padding: 10px 15px;
                        background: var(--primary-bg);
                        border: 1px solid var(--glass-border);
                        border-radius: 5px;
                        color: var(--text-primary);
                    ">
                    <button style="
                        padding: 10px 20px;
                        background: var(--gradient-1);
                        border: none;
                        border-radius: 5px;
                        color: white;
                        cursor: pointer;
                        transition: var(--transition);
                    ">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2024 Team KJSSE Robocon. All rights reserved. | Built with <span>❤</span> by Robocon Team</p>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // Register GSAP plugins
        gsap.registerPlugin(ScrollTrigger, TextPlugin);

        // ========== LOADING SCREEN ==========
        window.addEventListener('load', () => {
            gsap.to('.loader', {
                opacity: 0,
                duration: 0.5,
                delay: 2.2,
                onComplete: () => {
                    document.querySelector('.loader').style.display = 'none';
                    initAnimations();
                }
            });
        });

        // ========== CREATE PARTICLES ==========
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 50; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 15 + 's';
                particle.style.animationDuration = (Math.random() * 10 + 10) + 's';
                particlesContainer.appendChild(particle);
            }
        }
        createParticles();

        // ========== CREATE CIRCUIT BACKGROUND ==========
        function createCircuitLines() {
            const circuitBg = document.getElementById('circuitBg');
            for (let i = 0; i < 20; i++) {
                const line = document.createElement('div');
                line.className = 'circuit-line';
                line.style.width = Math.random() * 200 + 50 + 'px';
                line.style.height = '2px';
                line.style.left = Math.random() * 100 + '%';
                line.style.top = Math.random() * 100 + '%';
                line.style.transform = `rotate(${Math.random() * 360}deg)`;
                circuitBg.appendChild(line);
            }

            for (let i = 0; i < 15; i++) {
                const dot = document.createElement('div');
                dot.className = 'circuit-dot';
                dot.style.left = Math.random() * 100 + '%';
                dot.style.top = Math.random() * 100 + '%';
                circuitBg.appendChild(dot);
            }
        }
        createCircuitLines();

        // ========== TYPEWRITER EFFECT ==========
        const phrases = [
            'Innovating the Future of Robotics',
            'Building Champions Since 2015',
            'Excellence in Engineering',
            'Pushing Boundaries'
        ];
        let phraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const typewriterElement = document.getElementById('typewriter');

        function typeWriter() {
            const currentPhrase = phrases[phraseIndex];

            if (isDeleting) {
                typewriterElement.textContent = currentPhrase.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typewriterElement.textContent = currentPhrase.substring(0, charIndex + 1);
                charIndex++;
            }

            let typeSpeed = isDeleting ? 50 : 100;

            if (!isDeleting && charIndex === currentPhrase.length) {
                typeSpeed = 2000;
                isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
                typeSpeed = 500;
            }

            setTimeout(typeWriter, typeSpeed);
        }
        setTimeout(typeWriter, 2500);

        // ========== NAVIGATION ==========
        const navbar = document.querySelector('.navbar');
        const hamburger = document.querySelector('.hamburger');
        const navLinks = document.querySelector('.nav-links');
        const navLinksItems = document.querySelectorAll('.nav-links a');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        hamburger.addEventListener('click', () => {
            hamburger.classList.toggle('active');
            navLinks.classList.toggle('active');
        });

        navLinksItems.forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                navLinks.classList.remove('active');
            });
        });

        // Active nav link on scroll
        const sections = document.querySelectorAll('section');
        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (scrollY >= sectionTop - 200) {
                    current = section.getAttribute('id');
                }
            });

            navLinksItems.forEach(a => {
                a.classList.remove('active');
                if (a.getAttribute('href').slice(1) === current) {
                    a.classList.add('active');
                }
            });
        });


        // ========== CLEAN TITLE ANIMATION ==========
        function initTitleAnimation() {
            const titleElement = document.getElementById('premiumTitle');
            const text = titleElement.textContent;

            // Clear the title and wrap each character for hover effects
            titleElement.innerHTML = '';

            text.split('').forEach((char, index) => {
                const span = document.createElement('span');
                span.className = 'title-char';
                span.textContent = char === ' ' ? '\u00A0' : char;
                titleElement.appendChild(span);
            });
        }

        // ========== GSAP ANIMATIONS ==========
        function initAnimations() {
            // Initialize title animation
            initTitleAnimation();

            // Hero animations
            gsap.from('.hero-logo', {
                scale: 0,
                opacity: 0,
                duration: 1,
                ease: 'back.out(1.7)'
            });

            gsap.from('.hero-title', {
                y: 50,
                opacity: 0,
                duration: 1,
                delay: 0.5
            });

            gsap.from('.hero-tagline', {
                y: 30,
                opacity: 0,
                duration: 1,
                delay: 1.5
            });

            gsap.from('.hero-cta', {
                y: 30,
                opacity: 0,
                duration: 1,
                delay: 1.8,
                stagger: 0.2
            });

            // Section headers
            gsap.utils.toArray('.section-header').forEach(header => {
                gsap.from(header, {
                    scrollTrigger: {
                        trigger: header,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    y: 50,
                    opacity: 0,
                    duration: 1
                });
            });

            // Timeline items
            gsap.utils.toArray('.timeline-item').forEach((item, index) => {
                gsap.from(item, {
                    scrollTrigger: {
                        trigger: item,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    x: index % 2 === 0 ? -50 : 50,
                    opacity: 0,
                    duration: 1,
                    delay: index * 0.2
                });
            });

            // Achievement cards
            gsap.utils.toArray('.achievement-card').forEach((card, index) => {
                gsap.from(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    y: 50,
                    opacity: 0,
                    duration: 0.8,
                    delay: index * 0.1
                });
            });

            // Robot cards
            gsap.utils.toArray('.robot-card').forEach((card, index) => {
                gsap.from(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    y: 100,
                    opacity: 0,
                    duration: 1,
                    delay: index * 0.2
                });
            });

            // Department cards
            gsap.utils.toArray('.dept-card').forEach((card, index) => {
                gsap.from(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    scale: 0.8,
                    opacity: 0,
                    duration: 0.8,
                    delay: index * 0.1
                });
            });

            // Stat items
            gsap.utils.toArray('.stat-item').forEach((item, index) => {
                gsap.from(item, {
                    scrollTrigger: {
                        trigger: item,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    scale: 0,
                    opacity: 0,
                    duration: 0.8,
                    delay: index * 0.1
                });
            });

            // Contact items
            gsap.utils.toArray('.contact-item').forEach((item, index) => {
                gsap.from(item, {
                    scrollTrigger: {
                        trigger: item,
                        start: 'top 80%',
                        toggleActions: 'play none none reverse'
                    },
                    x: -50,
                    opacity: 0,
                    duration: 0.8,
                    delay: index * 0.1
                });
            });
        }

        // ========== ANIMATED COUNTERS ==========
        function animateCounters() {
            const counters = document.querySelectorAll('.achievement-number');

            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-target'));
                const duration = 2000;
                const increment = target / (duration / 16);
                let current = 0;

                const updateCounter = () => {
                    current += increment;
                    if (current < target) {
                        counter.textContent = Math.ceil(current);
                        requestAnimationFrame(updateCounter);
                    } else {
                        counter.textContent = target;
                    }
                };

                ScrollTrigger.create({
                    trigger: counter,
                    start: 'top 80%',
                    onEnter: () => updateCounter(),
                    once: true
                });
            });
        }
        animateCounters();

        // ========== CIRCULAR PROGRESS ==========
        function animateCircularProgress() {
            const circles = document.querySelectorAll('.stat-circle-progress');

            circles.forEach(circle => {
                const progress = parseInt(circle.getAttribute('data-progress'));
                const circumference = 2 * Math.PI * 70;
                const offset = circumference - (progress / 100) * circumference;

                ScrollTrigger.create({
                    trigger: circle,
                    start: 'top 80%',
                    onEnter: () => {
                        circle.style.strokeDashoffset = offset;
                    },
                    once: true
                });
            });
        }
        animateCircularProgress();

        // ========== SPEC BARS ANIMATION ==========
        function animateSpecBars() {
            const specFills = document.querySelectorAll('.spec-fill');

            specFills.forEach(fill => {
                const width = fill.getAttribute('data-width');

                ScrollTrigger.create({
                    trigger: fill,
                    start: 'top 80%',
                    onEnter: () => {
                        fill.style.width = width;
                    },
                    once: true
                });
            });
        }
        animateSpecBars();

        // ========== FORM SUBMISSION ==========
        document.getElementById('contactForm').addEventListener('submit', (e) => {
            e.preventDefault();

            // Add your form submission logic here
            const btn = e.target.querySelector('.submit-btn');
            btn.innerHTML = '<i class="fas fa-check"></i> Message Sent!';
            btn.style.background = 'linear-gradient(135deg, #00ff88 0%, #00f5ff 100%)';

            setTimeout(() => {
                btn.innerHTML = 'Send Message <i class="fas fa-paper-plane" style="margin-left: 10px;"></i>';
                btn.style.background = '';
                e.target.reset();
            }, 3000);
        });

        // ========== SMOOTH SCROLL FOR NAV LINKS ==========
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>